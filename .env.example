GEMINI_API_KEY=

# --- Contributing to Moteur Index (optional) --------------------------------
# A partner key issued by moteurindex.com. Leave it empty and the "Add this to
# Lebanon's price map" panel stays hidden. Direct POSTs still return 503.
#
# Server-side only. It must never reach the browser bundle: anything shipped to the
# client is public, and a leaked key lets anyone file reports into the index's
# moderation queue under this app's name. api/contribute.js is the only reader.
MOTEUR_INDEX_KEY=

# The name the index knows this app by. Sent as X-Partner-Name alongside the key.
MOTEUR_INDEX_PARTNER=moteur-check
